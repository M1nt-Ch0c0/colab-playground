# Required: Web login password and API Bearer token (also used for the qp_auth cookie)
password=change-me-strong-password
token=change-me-long-random-token

# Optional: OpenAI-compatible endpoint for "AI Prompt Rewrite"
# cpa_base=http://127.0.0.1:8317
# cpa_key=sk-your-openai-compatible-key
# cpa_model=gemini-2.5-flash

# Optional: Default Hugging Face token (can also be configured in Web UI -> Settings)
# hf_token=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Managed outbound proxy presets for Google Colab API (never exposed to browser)
# Localhost (127.0.0.1 / localhost / ::1) always bypasses proxy.
# proxy_url_us=http://user:pass@us-proxy.example.com:8080
# proxy_url_sg=http://user:pass@sg-proxy.example.com:8080
